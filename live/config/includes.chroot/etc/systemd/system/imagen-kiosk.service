[Unit]
Description=IMAGen full-screen interface (cage + Firefox kiosk)
After=systemd-user-sessions.service imagen.service live-config.service plymouth-quit-wait.service
Wants=imagen.service
Conflicts=getty@tty1.service

[Service]
User=user
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/usr/local/bin/imagen ping -timeout 30s
ExecStart=/usr/local/bin/imagen-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
