#!/bin/sh
# live-build configuration for the ImaGen boot USB (Debian 13 "trixie").
# Produces a hybrid ISO that boots on both UEFI and legacy BIOS machines.
set -e

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --memtest none \
  --iso-application "ImaGen" \
  --iso-volume "IMAGEN" \
  --bootappend-live "boot=live components quiet splash loglevel=3 hostname=imagen username=user noautologin nopersistence" \
  --bootappend-live-failsafe "boot=live components quiet loglevel=3 nomodeset hostname=imagen username=user noautologin nopersistence" \
  --apt-recommends false \
  "${@}"
