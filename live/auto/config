#!/bin/sh
# live-build configuration for the IMAGen boot USB (Debian 13 "trixie").
# Produces a hybrid ISO that boots on both UEFI and legacy BIOS machines.
# "toram" copies the whole system into memory at boot, so the stick can be
# pulled out once the interface is up (live-boot skips it when RAM is short).
set -e

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --memtest none \
  --iso-application "IMAGen" \
  --iso-volume "IMAGEN" \
  --bootappend-live "boot=live components quiet splash loglevel=3 hostname=imagen username=user noautologin nopersistence toram" \
  --bootappend-live-failsafe "boot=live components quiet loglevel=3 nomodeset hostname=imagen username=user noautologin nopersistence toram" \
  --apt-recommends false \
  "${@}"
